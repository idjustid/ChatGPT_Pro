{
  "name": "egg-evolution-match",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "./scripts/start-app.sh",
    "ios": "./scripts/run-ios.sh",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "install:deps": "env -u npm_config_http_proxy -u npm_config_https_proxy ./scripts/install-deps.sh",
    "start:expo": "expo start",
    "start:preview": "python3 -m http.server 4173 --directory preview",
    "check:ios-sim": "./scripts/check-ios-sim.sh",
    "package:dmg": "./scripts/package-dmg.sh",
    "deploy:ios": "./scripts/deploy-ios.sh"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@types/react": "~18.2.79",
    "typescript": "^5.4.5"
  }
}
